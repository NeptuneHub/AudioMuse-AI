# .dockerignore

# Git and version control
.git
.gitignore
.gitattributes
.github

# Docker-specific files that shouldn't be in the image
.dockerignore
Dockerfile

# Deployment files
# These are for deploying the container, not for running the code inside it.
# deployment/
# !deployment/**
# !deployment/supervisord.conf
# !deployment/docker-entrypoint.sh
test/

# Student CLAP training (not needed in production)
student_clap/

# Native standalone app (macOS/Linux/Windows): the per-platform source trees
# (vendored pg binaries, assets, nfpm config, runtime launchers), the shared
# PyInstaller spec + build tooling, and build artifacts. None of it is used by the
# Linux container, so keep it out of the image.
native-build/
AudioMuse-AI.spec
scripts/standalone/
build/
dist/

# Python virtual environment and cache
__pycache__/
*.pyc
*.pyo
*.pyd
venv
.venv
.venv-windows
.venv-*
env
.env*

# SAE sparse autoencoder workspace: training code, the 4 GB venv, the embedding
# corpus, checkpoints and every exported model. Nothing here runs in production.
# The three runtime artifacts it produces live at the project root instead.
SAE/

# IDE and editor configuration
.vscode/
.idea/

# Documentation, screenshots, and local test files
README.md
docs/
query/
metadata/
screenshot/
.pytest_cache/
htmlcov/
.coverage
*.log

# Large model files and caches (these are downloaded inside the container)
model/
*.onnx
# The SAE concept catalogue is small and ships in the repository; the two ONNX
# graphs it refers to are downloaded into model/ by the Dockerfile.
!dclap_sae_concepts.json
*.pt
*.pth
*.bin
*.h5
*.pb
.cache/
*.tar.gz
