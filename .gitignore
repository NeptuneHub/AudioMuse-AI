# .gitignore

# Python virtual environment and cache
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
.venv-macos/
.venv-linux/
.venv-windows/
env/

# Linux native build inputs built fresh in CI (not committed; see .github/workflows/build-linux.yml)
/native-build/linux/vendor/pg-contrib/*/
/native-build/linux/vendor/postgres/*/

# Local environment variables
# IMPORTANT: Never commit your .env file with secrets!
.env*
!.env.example
!.env.test.example
# You can add an exception for an example file if you create one
# !.env.example

# IDE and editor configuration
.vscode/
.idea/

# macOS Finder / metadata files
.DS_Store
.DS_store

# Temporary files generated by the application
# This directory is used to download audio files from Jellyfin
/temp_audio/

# Plugin runtime cache: installed plugins are materialized here from the DB at boot
/plugin/installed/*
!/plugin/installed/.gitkeep

# Log files
*.log

# Test artifacts
.pytest_cache/
htmlcov/
nul

# Downloaded ONNX models (from run_worker_macos.sh or similar)
/model/

# Test models (downloaded by CI workflow from GitHub Releases)
test/models/*.onnx
test/models/*.onnx.data

# Student CLAP training artifacts
student_clap/cache/
student_clap/checkpoints/
student_clap/logs/
student_clap/models/*.onnx
student_clap/config.local.yaml
student_clap/models/FMA_SONGS_LICENSE.md
student_clap/models/FMA_SONGS_2247_LICENSE.md

# bn research prototype artifacts
query/

# macOS standalone build artifacts (PyInstaller output)
/build/
/dist/

# Testing suite
testing_suite/
analysis.md
.claude/
lyrics_model_gte_vnni.tar.gz
.reasonix/
metadata/

# SAE sparse-autoencoder workspace: training code, the 4 GB venv, the embedding
# corpus, checkpoints and exported models. None of it belongs in the repo. The
# three runtime artifacts (encoder/decoder .onnx and the concept catalogue) are
# read from the project root at runtime and will move to a release download,
# like the other models, rather than being committed here.
/SAE/
